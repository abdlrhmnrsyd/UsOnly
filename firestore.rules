rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isAuthenticated() {
      return request.auth != null;
    }

    function isUser(uid) {
      return isAuthenticated() && request.auth.uid == uid;
    }

    function isCoupleMember(coupleId) {
      return isAuthenticated() &&
        request.auth.uid in get(/databases/$(database)/documents/coupleSpaces/$(coupleId)).data.memberUids;
    }

    // 1. Users collection
    match /users/{uid} {
      allow read: if isAuthenticated();
      allow create: if isUser(uid);
      allow update: if isUser(uid) || (
        // Allow updating coupleId during pairing redemption
        isAuthenticated() && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['coupleId', 'updatedAt'])
      );
      allow delete: if isUser(uid);

      match /deviceTokens/{tokenId} {
        allow read, write: if isUser(uid);
      }
    }

    // 2. Couple Spaces
    match /coupleSpaces/{coupleId} {
      allow read: if isAuthenticated() && (
        request.auth.uid in resource.data.memberUids ||
        resource.data.status == 'pending'
      );
      allow create: if isAuthenticated() &&
        request.resource.data.memberUids.hasAll([request.auth.uid]) &&
        request.resource.data.memberUids.size() == 1 &&
        request.resource.data.status == 'pending';
      allow update: if isAuthenticated() && (
        request.auth.uid in resource.data.memberUids ||
        (resource.data.status == 'pending' && resource.data.memberUids.size() < 2)
      ) && request.resource.data.memberUids.size() <= 2;
      allow delete: if isAuthenticated() && request.auth.uid in resource.data.memberUids;

      // Media metadata subcollection
      match /media/{mediaId} {
        allow read: if isCoupleMember(coupleId);
        allow create: if isCoupleMember(coupleId) && request.resource.data.uploadedBy == request.auth.uid;
        allow update, delete: if isCoupleMember(coupleId) && resource.data.uploadedBy == request.auth.uid;
      }

      // Memories subcollection
      match /memories/{memoryId} {
        allow read: if isCoupleMember(coupleId);
        allow create: if isCoupleMember(coupleId) && request.resource.data.createdBy == request.auth.uid;
        allow update, delete: if isCoupleMember(coupleId);
      }

      // Live Tracking & Locations
      match /locations/{uid} {
        allow read, write: if isCoupleMember(coupleId);
      }

      // In-App Notifications
      match /notifications/{notifId} {
        allow read, write: if isCoupleMember(coupleId);
      }
    }

    // 3. Pairing codes (single-use, 10 min expiry)
    match /pairingCodes/{codeHash} {
      allow create: if isAuthenticated() && request.resource.data.createdBy == request.auth.uid;
      allow read: if isAuthenticated();
      allow update: if isAuthenticated() && (
        resource.data.usedAt == null &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['usedAt', 'updatedAt'])
      );
      allow delete: if isAuthenticated() && resource.data.createdBy == request.auth.uid;
    }

    // 4. Conversations & Real-Time Messages
    match /conversations/{conversationId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated();
      allow update: if isAuthenticated();

      match /messages/{messageId} {
        allow read: if isAuthenticated();
        allow create: if isAuthenticated() && request.resource.data.senderUid == request.auth.uid;
        allow update: if isAuthenticated() && (
          resource.data.senderUid == request.auth.uid ||
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['readBy'])
        );
        allow delete: if isAuthenticated() && resource.data.senderUid == request.auth.uid;
      }
    }
  }
}
