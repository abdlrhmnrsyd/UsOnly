rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {

    function isAuthenticated() {
      return request.auth != null;
    }

    function isImageOrVideo() {
      return request.resource.contentType.matches('image/.*') ||
             request.resource.contentType.matches('video/.*');
    }

    function isReasonableSize() {
      return request.resource.size < 15 * 1024 * 1024; // 15 MB limit
    }

    // Profile photos
    match /users/{uid}/profile/{fileName} {
      allow read: if isAuthenticated();
      allow write: if isAuthenticated() && request.auth.uid == uid &&
                   request.resource.contentType.matches('image/.*') &&
                   request.resource.size < 5 * 1024 * 1024;
    }

    // Shared couple media & memory photos
    match /couples/{coupleId}/media/{fileName} {
      allow read: if isAuthenticated();
      allow write: if isAuthenticated() &&
        isImageOrVideo() &&
        isReasonableSize();
    }
  }
}
